    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Qrioso NoPing Service</AssemblyName>
    <Product>Qrioso NoPing</Product>
    <AssemblyTitle>Qrioso NoPing Service</AssemblyTitle>
    <Description>Servicio local de red de Qrioso NoPing.</Description>
    <Company>Qrioso Software Consulting</Company>
    <Authors>Qrioso Software Consulting</Authors>
    <Copyright>Copyright © 2026 Qrioso Software Consulting</Copyright>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-private-preview</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../QriosoNoPing.Core/QriosoNoPing.Core.csproj" />
  </ItemGroup>
</Project>
