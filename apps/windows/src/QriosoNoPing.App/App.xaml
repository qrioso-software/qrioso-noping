<Application
    x:Class="QriosoNoPing.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandNavy">#030326</Color>
            <Color x:Key="BrandAccent">#00ADBB</Color>
            <Color x:Key="BrandAccentSoft">#173B4A</Color>
            <Color x:Key="AppBackground">#080B1F</Color>
            <Color x:Key="AppSurface">#10142D</Color>
            <Color x:Key="AppSurfaceRaised">#151A38</Color>
            <Color x:Key="AppBorder">#292F51</Color>
            <Color x:Key="TextPrimary">#F5F7FF</Color>
            <Color x:Key="TextSecondary">#A9B1CF</Color>

            <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavy}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}" />
            <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="{StaticResource BrandAccentSoft}" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="{StaticResource AppSurfaceRaised}" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{StaticResource BrandAccentBrush}" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="BrandPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrandAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BrandNavyBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20,11" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
